{
  "name": "morseo",
  "version": "1.0.0",
  "description": "Morse Code Time Reminder - Ambient time awareness through morse code",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "keywords": [
    "electron",
    "morse-code",
    "time-reminder",
    "productivity"
  ],
  "author": "mahmudhas",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.mahmudhas.morseo",
    "productName": "Morseo",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "utils/**/*",
      "assets/**/*"
    ]
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0"
  }
}